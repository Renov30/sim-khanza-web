# SIMRS Khanza Web Environment Configuration
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Dipakai hanya oleh npm run migrasi:khanza. Sumber dan tujuan wajib berbeda.
DB_SUMBER_HOST=
DB_SUMBER_PORT=3306
DB_SUMBER_USER=
DB_SUMBER_PASSWORD=
DB_SUMBER_DATABASE=
DB_TUJUAN_HOST=
DB_TUJUAN_PORT=3306
DB_TUJUAN_USER=
DB_TUJUAN_PASSWORD=
DB_TUJUAN_DATABASE=
MIGRASI_UKURAN_KELOMPOK=500

# Security Keys
KHANZA_AES_USER_KEY=
KHANZA_AES_PASS_KEY=
SESSION_SECRET=

# Sesuaikan dengan URUTNOREG dan BASENOREG pada setting/database.xml Khanza.
# URUTNOREG: poli | dokter | dokter + poli
# BASENOREG: registrasi | booking
KHANZA_URUTNOREG=dokter + poli
KHANZA_BASENOREG=booking
