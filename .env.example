# SIMRS Khanza Web Environment Configuration
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Security Keys
KHANZA_AES_USER_KEY=
KHANZA_AES_PASS_KEY=
SESSION_SECRET=

# Sesuaikan dengan URUTNOREG dan BASENOREG pada setting/database.xml Khanza.
# URUTNOREG: poli | dokter | dokter + poli
# BASENOREG: registrasi | booking
KHANZA_URUTNOREG=dokter + poli
KHANZA_BASENOREG=booking
