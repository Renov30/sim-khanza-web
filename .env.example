# SIMRS Khanza Web Environment Configuration
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# PROTOTIPE DITUNDA. Dipakai hanya bila pekerjaan migrasi diaktifkan kembali.
# Sumber dan tujuan wajib berbeda.
DB_SUMBER_HOST=
DB_SUMBER_PORT=3306
DB_SUMBER_USER=
DB_SUMBER_PASSWORD=
DB_SUMBER_DATABASE=
DB_TUJUAN_HOST=
DB_TUJUAN_PORT=3306
DB_TUJUAN_USER=
DB_TUJUAN_PASSWORD=
DB_TUJUAN_DATABASE=
MIGRASI_UKURAN_KELOMPOK=500

# Security Keys
KHANZA_AES_USER_KEY=
KHANZA_AES_PASS_KEY=
SESSION_SECRET=

# Sesuaikan dengan URUTNOREG dan BASENOREG pada setting/database.xml Khanza.
# URUTNOREG: poli | dokter | dokter + poli
# BASENOREG: registrasi | booking
KHANZA_URUTNOREG=dokter + poli
KHANZA_BASENOREG=booking

# Daftar modul web yang aktif, dipisahkan koma. Bila kosong/tidak diisi, semua
# modul tetap aktif agar instalasi lama tidak berubah. Restart aplikasi setelah mengubahnya.
# ID valid: registrasi,pasien,rawat-jalan,rawat-inap,igd,laboratorium,radiologi,farmasi,sdm,referensi
# Contoh klinik tanpa rawat inap:
# KHANZA_ENABLED_MODULES=registrasi,pasien,rawat-jalan,farmasi,laboratorium,radiologi,sdm,referensi

# =============================================================================
# Konfigurasi Tambahan dari setting/database.xml Khanza Java (Plain Text / Tanpa Hash)
