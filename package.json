{
  "name": "khanza-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrasi:khanza": "node --env-file=.env.migrasi.local scripts/migrasi-khanza.mjs",
    "migrasi:layanan": "node --env-file=.env.migrasi.local scripts/migrasi-layanan.mjs",
    "test:registrasi": "tsc --target ES2022 --module commonjs --esModuleInterop --strict --skipLibCheck --outDir .next/registrasi-tests src/lib/registrasi/date.ts src/lib/registrasi/numbering.ts tests/registrasi-numbering.test.ts && node --test .next/registrasi-tests/tests/registrasi-numbering.test.js tests/registrasi-api.test.mjs",
    "test:permintaan-lab-pk": "node --test tests/permintaan-lab-pk-api.test.mjs",
    "test:periksa-lab-pk": "node --test tests/periksa-lab-pk-api.test.mjs",
    "test:periksa-lab-mb-pa": "node --test tests/periksa-lab-mb-pa-api.test.mjs",
    "test:permintaan-radiologi": "node --test tests/permintaan-radiologi-api.test.mjs",
    "test:rawat-jalan": "node --test tests/rawat-jalan-api.test.mjs tests/tindakan-rawat-jalan-api.test.mjs tests/pemeriksaan-ralan-api.test.mjs tests/pemeriksaan-obgyn-api.test.mjs tests/diagnosa-catatan-api.test.mjs",
    "test:tindakan-ranap": "node --test tests/tindakan-rawat-inap-api.test.mjs",
    "test:rawat-inap": "node --test tests/rawat-inap-api.test.mjs",
    "test:rawat-inap-mutasi": "node --test tests/rawat-inap-mutasi-api.test.mjs",
    "test:igd": "node --test tests/igd-api.test.mjs",
    "test:resep-obat": "node --test tests/resep-obat-api.test.mjs tests/daftar-resep-dokter-api.test.mjs",
    "test:copy-resep": "node --test tests/copy-resep-api.test.mjs",
    "test:master-obat": "node --test tests/master-obat-api.test.mjs",
    "test:pegawai": "node --test tests/pegawai-api.test.mjs",
    "test:petugas": "node --test tests/petugas-api.test.mjs",
    "test:dokter": "node --test tests/dokter-api.test.mjs",
    "test:poliklinik": "node --test tests/poliklinik-api.test.mjs",
    "test:jadwal-dokter": "node --test tests/jadwal-dokter-api.test.mjs",
    "test:tarif-perawatan": "node --test tests/tarif-perawatan-api.test.mjs",
    "test:tarif-lab": "node --test tests/tarif-lab-api.test.mjs tests/tarif-lab-template-api.test.mjs",
    "test:riwayat-pasien": "node --test tests/riwayat-pasien-api.test.mjs",
    "test:resume-pasien": "node --test tests/resume-pasien-api.test.mjs",
    "test:menu-konteks": "tsc --target ES2022 --module commonjs --esModuleInterop --strict --skipLibCheck --outDir .next/menu-tests tests/menu-konteks.test.ts && node --test .next/menu-tests/tests/menu-konteks.test.js",
    "test:menu-utama": "tsc --target ES2022 --module commonjs --esModuleInterop --strict --skipLibCheck --outDir .next/menu-utama-tests tests/menu-utama.test.ts && node --test .next/menu-utama-tests/tests/menu-utama.test.js",
    "test:pasien": "tsc --target ES2022 --module commonjs --esModuleInterop --strict --skipLibCheck --outDir .next/pasien-tests tests/pasien-fields.test.ts tests/pasien-numbering.test.ts && node --test .next/pasien-tests/tests/pasien-fields.test.js .next/pasien-tests/tests/pasien-numbering.test.js tests/pasien-api.test.mjs",
    "db:index-kinerja": "node --env-file=.env.local scripts/db/index-kinerja.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "mysql2": "^3.24.6",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
